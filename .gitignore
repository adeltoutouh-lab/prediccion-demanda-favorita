models/
outputs/backtest_predictions.parquet
outputs/forecast.parquet
outputs/*.log
powerbi/**/.pbi/
tmp/
*.log
.pytest_cache/

# Carpetas locales de datos
data/raw/
data/processed/
data/gold/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/


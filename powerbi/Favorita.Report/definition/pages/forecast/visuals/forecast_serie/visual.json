{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "forecast_serie",
  "position": {
    "x": 270,
    "y": 280,
    "z": 0,
    "width": 1135,
    "height": 260,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "Calendario.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Ventas historicas"
                }
              },
              "queryRef": "Medidas.Ventas historicas",
              "nativeQueryRef": "Ventas historicas"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Ventas previstas"
                }
              },
              "queryRef": "Medidas.Ventas previstas",
              "nativeQueryRef": "Ventas previstas"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Histórico reciente y previsión de 16 días'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "13D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
